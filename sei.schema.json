{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEISyntaxSpecification",
  "description": "Abstract schema and syntax logic for DPRLAB Synthetic Environment Infrastructure (SEI).",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "const": "DPRLAB"
    },
    "orcid": {
      "type": "string",
      "const": "0009-0006-5721-5848"
    },
    "system": {
      "type": "string",
      "enum": ["Domus Mare", "Think Furniture"]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "moment_capacity_kNm": {
          "type": "number",
          "description": "Finite element analysis validated moment capacity."
        },
        "envelope_rating": {
          "type": "string"
        }
      },
      "required": ["moment_capacity_kNm"]
    }
  },
  "required": ["entity", "orcid", "system", "constraints"]
}
